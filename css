* {
	box-sizing: border-box;
}

body {
	font-family: Arial, Helvetica, sans-serif;
	max-width: 600px;
	margin: 30px auto;
	padding: 20px;
	color: #1b2845;
}

h1 {
	margin-bottom: 24px;
}

.aggiunta {
	display: flex;
	gap: 10px;
	margin-bottom: 20px;
}

input {
	flex: 1;
	padding: 10px;
	font-size: 16px;
	font-family: inherit;
	border: 1px solid #1b2845;
	border-radius: 2px;
}

button {
	padding: 10px 20px;
	cursor: pointer;
	font-family: inherit;
	background-color: #fff;
	border: 1px solid #1b2845;
	border-radius: 4px;
	color: #1b2845;
}

ul {
	list-style: none;
	padding: 0;
	margin: 0;
}

li {
	padding: 12px;
	display: flex;
	align-items: center;
	margin-bottom: 6px;
	border-radius: 2px;
}

.priorita-alta {
	background-color: #FDE2E2;
}

.priorita-media {
	background-color: #FFFBE6;
}

.priorita-bassa {
	background-color: #E2F5E2;
}

.badge {
	font-size: 11px;
	font-weight: bold;
	padding: 3px 8px;
	border-radius: 10px;
	background-color: #1b2845;
	color: white;
	text-transform: uppercase;
	margin-left: 8px;
}

.data {
	font-size: 12px;
	color: #555;
	margin-left: auto;
	margin-right: 10px;
}

.evidenziato {
	border: 2px solid #F6C948;
}

li button {
	font-size: 12px;
	padding: 5px 10px;
	background-color: #fff;
	border: 1px solid #1b2845;
	border-radius: 4px;
	cursor: pointer;
}
