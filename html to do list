<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ToDoList</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <main class="container">
    <h1>Le mie cose da fare</h1>

    <form id="form-task">
      <div class="form-group">
        <input type="text" id="input-testo" placeholder="Cosa devi fare?" autocomplete="off">
        <button type="submit">Aggiungi</button>
      </div>
      <div id="errore" class="errore"></div>
    </form>

    <div class="filtri">
      <button class="btn-filtro attivo" data-filtro="tutti">Tutti</button>
      <button class="btn-filtro" data-filtro="attivi">Attivi</button>
      <button class="btn-filtro" data-filtro="completati">Completati</button>
    </div>

    <ul id="lista-task"></ul>

    <div id="contatore" class="contatore"></div>
  </main>

  <script src="script.js"></script>
</body>
</html>
